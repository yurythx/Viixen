# Feature flags
FEATURE_ARTICLES_ENABLED=True
FEATURE_CHAT_ENABLED=False
FEATURE_NOTIFICATIONS_ENABLED=True
FEATURE_API_ENABLED=False

# =============================================================================
# BACKUP & MAINTENANCE
# =============================================================================

