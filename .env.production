# =============================================================================
# DJANGO CORE SETTINGS - PRODUCTION
# =============================================================================

# SECURITY WARNING: Generate a new secret key for production!
SECRET_KEY=your-super-secret-production-key-here-minimum-50-characters-long

# SECURITY WARNING: Set to False in production!
DEBUG=False

# Hosts permitidos em produção (separados por vírgula)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,your-server-ip

# Timezone e idioma
TIME_ZONE=America/Sao_Paulo
LANGUAGE_CODE=pt-br
USE_I18N=True
USE_TZ=True

# =============================================================================
# DATABASE SETTINGS - PRODUCTION
# =============================================================================

# PostgreSQL para produção (recomendado)
DATABASE_URL=postgresql://viixen_user:your_secure_password@localhost:5432/viixen_production

# Configurações de conexão para produção
DB_CONN_MAX_AGE=600
DB_CONN_HEALTH_CHECKS=True
DB_ATOMIC_REQUESTS=True
DB_AUTOCOMMIT=True

# =============================================================================
# EMAIL SETTINGS - PRODUCTION
# =============================================================================

# Backend de email para produção
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Configurações SMTP de produção
EMAIL_HOST=smtp.yourdomain.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@yourdomain.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=30

# Email padrão do sistema
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
SERVER_EMAIL=admin@yourdomain.com

# =============================================================================
# SECURITY SETTINGS - PRODUCTION
# =============================================================================

# HTTPS e SSL obrigatórios
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# HSTS (HTTP Strict Transport Security)
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Cookies seguros
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_AGE=3600
SESSION_EXPIRE_AT_BROWSER_CLOSE=True
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=True

# Proteções adicionais
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY

# =============================================================================
# STATIC & MEDIA FILES - PRODUCTION
# =============================================================================

# Arquivos estáticos para produção
STATIC_URL=/static/
STATIC_ROOT=/var/www/viixen/static/
STATICFILES_STORAGE=django.contrib.staticfiles.storage.ManifestStaticFilesStorage

# Arquivos de media para produção
MEDIA_URL=/media/
MEDIA_ROOT=/var/www/viixen/media/

# CDN (opcional)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1

# =============================================================================
# CACHE SETTINGS - PRODUCTION
# =============================================================================

# Redis para cache em produção
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
REDIS_URL=redis://localhost:6379/0
CACHE_TIMEOUT=300
CACHE_KEY_PREFIX=viixen_prod

# =============================================================================
# LOGGING SETTINGS - PRODUCTION
# =============================================================================

# Logs para produção
LOG_LEVEL=WARNING
LOG_FILE=/var/log/viixen/django.log
LOG_MAX_SIZE=52428800
LOG_BACKUP_COUNT=10

# =============================================================================
# MONITORING & PERFORMANCE - PRODUCTION
# =============================================================================

# Sentry para monitoramento de erros
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production

# Performance
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
DATA_UPLOAD_MAX_NUMBER_FIELDS=1000

# =============================================================================
# BACKUP & MAINTENANCE - PRODUCTION
# =============================================================================

# Backup automático
BACKUP_ENABLED=True
BACKUP_STORAGE_PATH=/var/backups/viixen/
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=daily

# Manutenção
MAINTENANCE_MODE=False
MAINTENANCE_MESSAGE=Sistema em manutenção programada. Voltamos em breve!

# =============================================================================
# FEATURE FLAGS - PRODUCTION
# =============================================================================

# Funcionalidades habilitadas
FEATURE_ARTICLES_ENABLED=True
FEATURE_CHAT_ENABLED=True
FEATURE_NOTIFICATIONS_ENABLED=True
FEATURE_API_ENABLED=True

# Configurações específicas da aplicação
VIIXEN_VERSION=1.0.0
VIIXEN_MAINTENANCE_MODE=False
VIIXEN_ALLOW_REGISTRATION=True
VIIXEN_REQUIRE_EMAIL_VERIFICATION=True
VIIXEN_ENABLE_APP_MANAGEMENT=True
